#!/bin/sh
# Restarts tailscaled when the Funnel hostname has lost its public DNS record.
# Asks ts.net's authoritative servers, so negative caching never delays recovery.
host=mini.tail899cb0.ts.net
for ns in ns1.dnsimple.com ns2.dnsimple-edge.net; do
  /usr/bin/dig +short +time=5 +tries=2 A "$host" @"$ns" | /usr/bin/grep -q . && exit 0
done
# No answer at all: only act when the internet itself works.
/usr/bin/dig +short +time=5 A tailscale.com @1.1.1.1 | /usr/bin/grep -q . || exit 0
/usr/bin/logger -t funnel-watchdog "no public DNS for $host, restarting tailscaled"
/bin/launchctl kickstart -k system/sh.brew.tailscale
