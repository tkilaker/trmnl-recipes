{% assign style = trmnl.plugin_settings.custom_fields_values.style | default: 'image' %}
{% if style == 'list' %}{% assign first = 0 %}{% assign per_col = 5 %}{% else %}{% assign first = 1 %}{% assign per_col = 4 %}{% endif %}
<div class="layout">
  {% if items.size > 0 %}
    <div class="news news--{{ style }}">
      {% if style != 'list' %}
        {% assign lead = items.first %}
        <div class="news__hero">
          <figure class="news__media">
            {% if lead.image != blank %}<img class="image-dither" src="{{ lead.image }}">{% endif %}
            {{ qr }}
          </figure>
          <div class="news__lead">
            <div class="flex gap--small">
              <span class="label label--small label--inverted">1</span>
              <span class="label label--small label--underline">{{ lead.category }}</span>
              {% if lead.kind == 'latest' %}<span class="label label--small label--inverted">Just nu</span>{% endif %}
            </div>
            <span class="title title--large">{{ lead.title | strip_html }}</span>
            <span class="description">{{ lead.description | strip_html }}</span>
          </div>
        </div>
      {% endif %}
      <div class="news__cols">
        {% for group in (0..1) %}
          {% assign offset = group | times: per_col | plus: first %}
          <div class="news__col" style="grid-template-rows: repeat({{ per_col }}, minmax(0, 1fr))">
            {% for item in items offset: offset limit: per_col %}
              <div class="item">
                <div class="meta"><span class="index">{{ forloop.index | plus: offset }}</span></div>
                <div class="content">
                  <span class="title title--small">{{ item.title | strip_html }}</span>
                  <span class="description">{{ item.description | strip_html }}</span>
                  <div class="flex gap--small">
                    <span class="label label--small label--underline">{{ item.category }}</span>
                    {% if item.time != blank %}<span class="label label--small label--underline">{{ item.time | slice: -5, 5 }}</span>{% endif %}
                    {% if item.kind == 'latest' %}<span class="label label--small label--inverted">Just nu</span>{% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
      {% if style == 'list' %}
        <div class="news__rail">{{ qr }}<span class="label label--small">Läs mer</span></div>
      {% endif %}
    </div>
  {% else %}
    <span class="title">Inga nyheter tillgängliga</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6MTY0OTIxNTYsInB1ciI6ImJsb2JfaWQifX0=--18aedec066b09020e2b282d83b12019440f0058f/icon.png">
  <span class="title">Sydsvenskan</span>
  <span class="instance">Hämtad {{ capturedLabel | default: capturedAt }}</span>
</div>
