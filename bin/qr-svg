#!/usr/bin/env python3
"""Prints the inline QR <svg> used in the templates: qr-svg HTTPS://HOST/LAS/HN"""
import subprocess, sys

rows = subprocess.run(['qrencode', '-t', 'ASCII', '-l', 'M', '-m', '0', sys.argv[1]],
                      capture_output=True, text=True, check=True).stdout.splitlines()
size = len(rows) + 4
path = []
for y, row in enumerate(rows):
    cells = [row[i:i + 2] == '##' for i in range(0, len(row), 2)]
    x = 0
    while x < len(cells):
        if cells[x]:
            start = x
            while x < len(cells) and cells[x]:
                x += 1
            path.append(f'M{start + 2} {y + 2}h{x - start}v1h-{x - start}z')
        x += 1
print(f'<svg viewBox="0 0 {size} {size}" shape-rendering="crispEdges"><rect width="{size}" height="{size}" fill="#fff"/><path d="{"".join(path)}"/></svg>')
