{% comment %}
DN News - Full Layout
Editorial front page for TRMNL X, condensed edition for the original display.
{% endcomment %}

<style>
  @font-face {
    font-family: "DN Serif";
    font-style: normal;
    font-weight: 600 800;
    src: url("https://cdn.dn-static.se/fonts/DNSerif-1-600-Variable-CHUYIAFV.woff2") format("woff2");
  }
  @font-face {
    font-family: "DN Sans";
    font-style: normal;
    font-weight: 500 800;
    src: url("https://cdn.dn-static.se/fonts/DNSans-1-500-Variable-VAP36PT4.woff2") format("woff2");
  }
  .layout.news-paper {
    align-items: stretch;
    display: flex;
    flex-direction: column;
  }
  .news-x { display: none; }

  .news-og {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }
  .news-og__masthead {
    align-items: baseline;
    border-bottom: 2px solid #000;
    display: flex;
    justify-content: space-between;
    padding-bottom: 1cqh;
  }
  .news-og__brand {
    font-family: "DN Serif", Georgia, "Times New Roman", serif;
    font-size: 3.6cqw;
    font-weight: 700;
    letter-spacing: -.04em;
  }
  .news-og__updated, .news-og__meta {
    font-family: "DN Sans", Arial, Helvetica, sans-serif;
    font-size: 1.6cqw;
    font-weight: 700;
    letter-spacing: .06em;
  }
  .news-og__updated { margin-right: 2cqw; }
  .news-og__lead {
    border-bottom: 2px solid #000;
    display: grid;
    gap: 2cqw;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    min-height: 0;
    padding: 1.5cqh 0;
  }
  .news-og__lead-media, .news-x__lead-media {
    background: #ddd;
    margin: 0;
    min-height: 0;
    overflow: hidden;
  }
  .news-og__lead-image, .news-x__lead-image {
    filter: grayscale(1) contrast(1.15);
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .news-og__lead-copy {
    align-self: center;
    min-width: 0;
  }
  .news-og__lead-title {
    display: block;
    font-family: "DN Serif", Georgia, "Times New Roman", serif;
    font-size: 4.3cqw;
    font-weight: 700;
    letter-spacing: -.035em;
    line-height: 1.01;
    margin: .5cqh 0 1cqh;
  }
  .news-og__lead-description {
    display: block;
    font-family: "DN Sans", Arial, Helvetica, sans-serif;
    font-size: 2.05cqw;
    hyphens: auto;
    line-height: 1.15;
    text-align: justify;
    text-align-last: left;
  }
  .news-og__items {
    display: grid;
    flex: 1;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    min-height: 0;
  }
  .news-og__item {
    align-items: center;
    border-bottom: 1px solid #000;
    display: grid;
    gap: 1.5cqw;
    grid-template-columns: 3cqw minmax(0, 1fr);
    min-width: 0;
  }
  .news-og__item:last-child { border-bottom: 0; }
  .news-og__number {
    font-family: "DN Sans", Arial, Helvetica, sans-serif;
    font-size: 1.5cqw;
    font-weight: 700;
  }
  .news-og__item-title {
    display: block;
    font-family: "DN Serif", Georgia, "Times New Roman", serif;
    font-size: 2.3cqw;
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1.03;
  }
  .news-og__item-description {
    display: block;
    font-family: "DN Sans", Arial, Helvetica, sans-serif;
    font-size: 1.6cqw;
    hyphens: auto;
    line-height: 1.08;
    margin-top: .25cqh;
    text-align: justify;
    text-align-last: left;
  }
  .news-empty {
    align-items: center;
    display: flex;
    flex: 1;
    font-size: 3cqw;
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .news-og { display: none; }
    .news-x {
      display: grid;
      flex: 1;
      grid-template-rows: auto minmax(0, .82fr) minmax(0, 1.18fr);
      min-height: 0;
    }
    .news-x__masthead {
      align-items: center;
      border-bottom: 2px solid #000;
      display: grid;
      gap: 1.5cqw;
      grid-template-columns: 11.5cqw minmax(0, 1fr) auto;
      padding-bottom: 1.5cqh;
    }
    .news-x__mark {
      align-items: center;
      border: 2px solid #000;
      display: flex;
      font-family: "DN Serif", Georgia, "Times New Roman", serif;
      font-size: 6.3cqw;
      font-weight: 700;
      height: 9cqh;
      justify-content: center;
      letter-spacing: -.08em;
      line-height: 1;
    }
    .news-x__brand {
      font-family: "DN Serif", Georgia, "Times New Roman", serif;
      font-size: 4.4cqw;
      font-weight: 700;
      letter-spacing: -.055em;
      line-height: .9;
      white-space: nowrap;
    }
    .news-x__status {
      font-family: "DN Sans", Arial, Helvetica, sans-serif;
      font-size: 1.45cqw;
      font-weight: 500;
      letter-spacing: 0;
      margin-right: 3cqw;
      white-space: nowrap;
    }
    .news-x__hero {
      border-bottom: 1px solid #000;
      display: grid;
      gap: 3cqw;
      grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
      min-height: 0;
      padding: 1.5cqh 0;
    }
    .news-x__lead-media {
      border: 0;
    }
    .news-x__lead {
      border: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0;
    }
    .news-x__meta {
      font-family: "DN Sans", Arial, Helvetica, sans-serif;
      font-size: 1.55cqw;
      font-weight: 700;
      letter-spacing: .08em;
    }
    .news-x__lead-title {
      font-family: "DN Serif", Georgia, "Times New Roman", serif;
      font-size: 4.1cqw;
      font-weight: 700;
      letter-spacing: -.055em;
      line-height: .95;
      margin: 1cqh 0 1.5cqh;
    }
    .news-x__lead-description {
      font-family: "DN Sans", Arial, Helvetica, sans-serif;
      font-size: 1.7cqw;
      hyphens: auto;
      line-height: 1.16;
      text-align: justify;
      text-align-last: left;
    }
    .news-x__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      min-height: 0;
    }
    .news-x__card {
      border-bottom: 1px solid #000;
      border-right: 1px solid #000;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
      padding: .8cqh 1.5cqw .55cqh 0;
    }
    .news-x__card:nth-child(3n + 2), .news-x__card:nth-child(3n + 3) { padding-left: 1.5cqw; }
    .news-x__card:nth-child(3n) { border-right: 0; }
    .news-x__card:nth-child(n + 4) { border-bottom: 0; }
    .news-x__card-title {
      font-family: "DN Serif", Georgia, "Times New Roman", serif;
      font-size: 1.68cqw;
      font-weight: 700;
      letter-spacing: -.03em;
      line-height: .98;
    }
    .news-x__card-meta {
      font-family: "DN Sans", Arial, Helvetica, sans-serif;
      font-size: 1.08cqw;
      font-weight: 700;
      letter-spacing: .055em;
      line-height: 1;
      margin-bottom: .28cqh;
      text-transform: uppercase;
    }
    .news-x__card-description {
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      display: -webkit-box;
      font-family: "DN Sans", Arial, Helvetica, sans-serif;
      font-size: 1.28cqw;
      hyphens: auto;
      line-height: 1.06;
      margin-top: .2cqh;
      text-align: justify;
      text-align-last: left;
    }
  }
</style>

<div class="layout news-paper" lang="sv">
  {% if items.size > 0 %}
    <section class="news-og">
      <header class="news-og__masthead">
        <span class="news-og__brand">DAGENS NYHETER.</span>
        <span class="news-og__updated">HÄMTAD {{ capturedAt }}</span>
      </header>
      {% assign lead = items.first %}
      <article class="news-og__lead">
        <figure class="news-og__lead-media">
          {% if lead.image != blank %}<img class="news-og__lead-image image-dither" src="{{ lead.image }}">{% endif %}
        </figure>
        <div class="news-og__lead-copy">
          <span class="news-og__meta">{% if lead.time != blank %}{{ lead.time | slice: -5, 5 }} · {% endif %}{{ lead.category | upcase }} · {% if lead.kind == 'latest' %}JUST NU{% else %}DAGENS UTVALDA{% endif %}</span>
          <span class="news-og__lead-title clamp--2">{{ lead.title | strip_html }}</span>
          <span class="news-og__lead-description clamp--3">{{ lead.description | strip_html }}</span>
        </div>
      </article>
      <section class="news-og__items">
        {% for item in items offset: 1 limit: 4 %}
          <article class="news-og__item">
            <span class="news-og__number">{{ forloop.index | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <span class="news-og__item-title clamp--1">{{ item.title | strip_html }}</span>
              <span class="news-og__item-description clamp--1">{{ item.description | strip_html }}</span>
            </div>
          </article>
        {% endfor %}
      </section>
    </section>

    <section class="news-x">
      <header class="news-x__masthead">
        <span class="news-x__mark">DN</span>
        <span class="news-x__brand">DAGENS NYHETER.</span>
        <span class="news-x__status">HÄMTAD {{ capturedAt }}</span>
      </header>
      <section class="news-x__hero">
        <figure class="news-x__lead-media">
          {% if lead.image != blank %}<img class="news-x__lead-image image-dither" src="{{ lead.image }}">{% endif %}
        </figure>
        <article class="news-x__lead">
          <span class="news-x__meta">{% if lead.time != blank %}{{ lead.time | slice: -5, 5 }} · {% endif %}{{ lead.category | upcase }} · {% if lead.kind == 'latest' %}JUST NU{% else %}DAGENS UTVALDA{% endif %}</span>
          <span class="news-x__lead-title clamp--4">{{ lead.title | strip_html }}</span>
          <span class="news-x__lead-description clamp--5">{{ lead.description | strip_html }}</span>
        </article>
      </section>
      <section class="news-x__grid">
        {% for item in items offset: 1 limit: 6 %}
          <article class="news-x__card">
            <span class="news-x__card-meta">{% if item.time != blank %}{{ item.time | slice: -5, 5 }} · {% endif %}{{ item.category | upcase }} · {% if item.kind == 'latest' %}JUST NU{% else %}UTVALT{% endif %}</span>
            <span class="news-x__card-title clamp--3">{{ item.title | strip_html }}</span>
            <span class="news-x__card-description clamp--4">{{ item.description | strip_html }}</span>
          </article>
        {% endfor %}
      </section>
    </section>
  {% else %}
    <div class="news-empty">INGA NYHETER TILLGÄNGLIGA</div>
  {% endif %}
</div>
