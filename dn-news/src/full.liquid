{% comment %}
Dagens Nyheter - Full Layout
List style of TRMNL's native Hacker News plugin. "Med bild" (default) opens with
the lead story's photo, the QR code in its corner, then eight numbered stories;
"Bara lista" shows ten. The QR code opens trmnl.diane-feedback-relay.workers.dev/las/dn,
where the same numbers link to each story.
{% endcomment %}

<style>
  .news { display: grid; gap: 12px 24px; height: 100%; width: 100%; }
  .news--image { grid-template-rows: minmax(0, 40%) minmax(0, 1fr); }
  .news--list { grid-template-columns: minmax(0, 1fr) auto; }
  .news__hero { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); min-height: 0; }
  .news__media { background: #ddd; border-radius: 8px; margin: 0; min-height: 0; overflow: hidden; position: relative; }
  .news__media img { filter: grayscale(1) contrast(1.15); height: 100%; object-fit: cover; width: 100%; }
  .news__media .news__qr { background: #fff; border-top-left-radius: 8px; bottom: 0; padding: 4px 0 0 4px; position: absolute; right: 0; }
  .news__lead { display: flex; flex-direction: column; gap: 6px; justify-content: center; min-width: 0; }
  .news__lead .title { --title-large-font-family: var(--title-small-font-family); --title-large-font-weight: var(--title-small-font-weight); --title-large-font-smoothing: var(--title-small-font-smoothing); -webkit-box-orient: vertical; -webkit-line-clamp: 3; display: -webkit-box; overflow: hidden; }
  .news__lead .description { -webkit-box-orient: vertical; -webkit-line-clamp: 3; display: -webkit-box; overflow: hidden; }
  .news__cols { display: grid; gap: 0 24px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 0; }
  .news__col { display: grid; min-height: 0; min-width: 0; }
  .news__col .item { align-items: center; min-height: 0; overflow: hidden; }
  .news__col .title, .news__col .description { -webkit-box-orient: vertical; display: -webkit-box; overflow: hidden; }
  .news__col .title { -webkit-line-clamp: 1; }
  .news__col .description { display: none; }
  .news__qr svg { display: block; height: 87px; width: 87px; }
  .news__rail { align-items: center; align-self: end; display: flex; flex-direction: column; }
  .news__rail .label { margin-top: 4px; }
  @media (min-width: 900px) {
    .news__col .title { -webkit-line-clamp: 2; }
    .news__col .description { -webkit-line-clamp: 2; display: -webkit-box; }
    .news--list .news__col .description { -webkit-line-clamp: 3; }
    .news--image { grid-template-rows: minmax(0, 46%) minmax(0, 1fr); }
    .news__lead .description { -webkit-line-clamp: 8; font-size: var(--description-large-font-size); line-height: var(--description-large-line-height); }
    .news__qr svg { height: 116px; width: 116px; }
  }
</style>

