v1h-3zM8 23h1v1h-1zM11 23h1v1h-1zM13 23h1v1h-1zM15 23h4v1h-4zM25 23h1v1h-1zM2 24h1v1h-1zM4 24h3v1h-3zM8 24h1v1h-1zM10 24h1v1h-1zM12 24h2v1h-2zM15 24h1v1h-1zM17 24h2v1h-2zM21 24h1v1h-1zM25 24h2v1h-2zM2 25h1v1h-1zM8 25h1v1h-1zM11 25h1v1h-1zM13 25h5v1h-5zM20 25h1v1h-1zM23 25h2v1h-2zM26 25h1v1h-1zM2 26h7v1h-7zM10 26h1v1h-1zM12 26h1v1h-1zM14 26h1v1h-1zM17 26h1v1h-1zM21 26h2v1h-2zM25 26h2v1h-2z"/></svg>{% endcapture %}
<div class="layout news-paper" lang="sv">
  {% if items.size > 0 %}
    {% assign lead = items.first %}
    <section class="news-og">
      <header class="news-og__masthead">
        <span class="news-og__brand">DAGENS NYHETER.</span>
        <span class="news-og__time">{{ capturedLabel | default: capturedAt }}</span>
      </header>
      <article class="news-og__lead">
        <figure class="media">
          {% if lead.image != blank %}<img class="image-dither" src="{{ lead.image }}">{% endif %}
          {{ qr }}
        </figure>
        <div class="news-og__lead-copy">
          <span class="kicker"><b>1</b> {{ lead.category }}{% if lead.kind == 'latest' %} · JUST NU{% endif %}</span>
          <span class="news-og__lead-title lines l3">{{ lead.title | strip_html }}</span>
          <span class="news-og__lead-description ingress lines l4">{{ lead.description | strip_html }}</span>
        </div>
      </article>
      <section class="news-og__items">
        {% for item in items offset: 1 limit: 4 %}
          <article class="news-og__item">
            <span class="news-og__number">{{ forloop.index | plus: 1 }}</span>
            <div>
              <span class="news-og__item-title lines l1">{{ item.title | strip_html }}</span>
              <span class="news-og__item-description ingress lines l1">{{ item.description | strip_html }}</span>
            </div>
          </article>
        {% endfor %}
      </section>
    </section>

    <section class="news-x">
      <header class="news-x__masthead">
        <span class="news-x__mark">DN</span>
        <span class="news-x__brand">DAGENS NYHETER.</span>
        <span class="news-x__time">{{ capturedLabel | default: capturedAt }}</span>
      </header>
      <section class="news-x__hero">
        <figure class="media">
          {% if lead.image != blank %}<img class="image-dither" src="{{ lead.image }}">{% endif %}
          {{ qr }}
        </figure>
        <article class="news-x__lead">
          <span class="kicker"><b>1</b> {{ lead.category }}{% if lead.kind == 'latest' %} · JUST NU{% endif %}</span>
          <span class="news-x__lead-title lines l4">{{ lead.title | strip_html }}</span>
          <span class="news-x__lead-description ingress lines l5">{{ lead.description | strip_html }}</span>
        </article>
      </section>
      <section class="news-x__grid">
        {% for item in items offset: 1 limit: 6 %}
          <article class="news-x__card">
            <span class="kicker"><b>{{ forloop.index | plus: 1 }}</b> {% if item.time != blank %}{{ item.time | slice: -5, 5 }} · {% endif %}{{ item.category }}{% if item.kind == 'latest' %} · JUST NU{% endif %}</span>
            <span class="news-x__card-title lines l3">{{ item.title | strip_html }}</span>
            <span class="news-x__card-description ingress lines l4">{{ item.description | strip_html }}</span>
          </article>
        {% endfor %}
      </section>
    </section>
  {% else %}
    <div class="news-empty">INGA NYHETER TILLGÄNGLIGA</div>
  {% endif %}
</div>
