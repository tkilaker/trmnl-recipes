{% comment %}
DN News - Full Layout
Editorial front page for TRMNL X, condensed edition for the original display.
Numbers match mini.tail899cb0.ts.net/las/dn, which the QR code opens.
{% endcomment %}

<style>
  @font-face {
    font-family: "DN Serif";
    font-style: normal;
    font-weight: 600 800;
    src: url("https://cdn.dn-static.se/fonts/DNSerif-1-600-Variable-CHUYIAFV.woff2") format("woff2");
  }
  @font-face {
    font-family: "DN Sans";
    font-style: normal;
    font-weight: 500 800;
    src: url("https://cdn.dn-static.se/fonts/DNSans-1-500-Variable-VAP36PT4.woff2") format("woff2");
  }
  .news-paper { --serif: "DN Serif", Georgia, "Times New Roman", serif; --sans: "DN Sans", Arial, Helvetica, sans-serif; align-items: stretch; display: flex; flex-direction: column; }
  .lines { -webkit-box-orient: vertical; display: -webkit-box; overflow: hidden; }
  .l1 { -webkit-line-clamp: 1; } .l2 { -webkit-line-clamp: 2; } .l3 { -webkit-line-clamp: 3; } .l4 { -webkit-line-clamp: 4; } .l5 { -webkit-line-clamp: 5; }
  .ingress { font-family: var(--sans); hyphens: auto; }
  .kicker { font-family: var(--sans); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .kicker b { border: 1.5px solid #000; padding: 0 .3em; }
  .media { background: #ddd; margin: 0; min-height: 0; overflow: hidden; position: relative; }
  .media img { filter: grayscale(1) contrast(1.15); height: 100%; object-fit: cover; width: 100%; }
  .qr { background: #fff; bottom: 0; display: block; height: 87px; position: absolute; right: 0; width: 87px; }
  .news-x { display: none; }
  .news-empty { align-items: center; display: flex; flex: 1; font-size: 3cqw; font-weight: 700; }

  .news-og { display: flex; flex: 1; flex-direction: column; min-height: 0; }
  .news-og__masthead { align-items: baseline; border-bottom: 3px double #000; display: flex; justify-content: space-between; padding-bottom: .8cqh; }
  .news-og__brand { font-family: var(--serif); font-size: 3.6cqw; font-weight: 700; letter-spacing: -.04em; }
  .news-og__time { font-family: var(--sans); font-size: 1.9cqw; font-weight: 700; margin-right: 1cqw; }
  .news-og__lead { border-bottom: 2px solid #000; display: grid; flex: 0 0 47%; gap: 2cqw; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); min-height: 0; padding: 1.4cqh 0; }
  .news-og__lead-copy { align-self: center; min-width: 0; }
  .news-og__lead .kicker { font-size: 1.5cqw; }
  .news-og__lead-title { font-family: var(--serif); font-size: 3.4cqw; font-weight: 700; letter-spacing: -.03em; line-height: 1.02; margin: .8cqh 0; }
  .news-og__lead-description { font-size: 1.9cqw; line-height: 1.18; }
  .news-og__items { display: grid; flex: 1; grid-template-rows: repeat(4, minmax(0, 1fr)); min-height: 0; }
  .news-og__item { align-items: center; border-bottom: 1px solid #000; display: grid; gap: 1.5cqw; grid-template-columns: 3.2cqw minmax(0, 1fr); min-width: 0; }
  .news-og__item:last-child { border-bottom: 0; }
  .news-og__number { font-family: var(--serif); font-size: 2.6cqw; font-weight: 700; }
  .news-og__item-title { font-family: var(--serif); font-size: 2.25cqw; font-weight: 700; letter-spacing: -.02em; line-height: 1.05; }
  .news-og__item-description { font-size: 1.55cqw; line-height: 1.12; margin-top: .3cqh; }

  @media (min-width: 900px) {
    .news-og { display: none; }
    .news-x { display: grid; flex: 1; grid-template-rows: auto minmax(0, .9fr) minmax(0, 1.1fr); min-height: 0; }
    .qr { height: 116px; width: 116px; }
    .news-x__masthead { align-items: center; border-bottom: 4px double #000; display: grid; gap: 1.5cqw; grid-template-columns: auto minmax(0, 1fr) auto; padding-bottom: 1.2cqh; }
    .news-x__mark { border: 2px solid #000; font-family: var(--serif); font-size: 5.2cqw; font-weight: 700; letter-spacing: -.08em; line-height: 1; padding: .4cqh 1cqw .2cqh .6cqw; }
    .news-x__brand { font-family: var(--serif); font-size: 4.4cqw; font-weight: 700; letter-spacing: -.055em; line-height: .9; white-space: nowrap; }
    .news-x__time { font-family: var(--sans); font-size: 2.2cqw; font-weight: 700; margin-right: 2cqw; white-space: nowrap; }
    .news-x__hero { border-bottom: 2px solid #000; display: grid; gap: 3cqw; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); min-height: 0; padding: 1.6cqh 0; }
    .news-x__lead { display: flex; flex-direction: column; justify-content: center; min-width: 0; }
    .news-x__lead .kicker { font-size: 1.4cqw; }
    .news-x__lead-title { font-family: var(--serif); font-size: 4cqw; font-weight: 700; letter-spacing: -.045em; line-height: .98; margin: 1.2cqh 0 1.4cqh; }
    .news-x__lead-description { font-size: 1.75cqw; line-height: 1.22; }
    .news-x__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); min-height: 0; }
    .news-x__card { border-bottom: 1px solid #000; border-right: 1px solid #000; display: flex; flex-direction: column; justify-content: flex-start; min-width: 0; padding: 1.6cqh 1.6cqw .8cqh; }
    .news-x__card:nth-child(3n + 1) { padding-left: 0; }
    .news-x__card:nth-child(3n) { border-right: 0; padding-right: 0; }
    .news-x__card:nth-child(n + 4) { border-bottom: 0; }
    .news-x__card .kicker { font-size: 1.05cqw; margin-bottom: .6cqh; }
    .news-x__card-title { font-family: var(--serif); font-size: 1.85cqw; font-weight: 700; letter-spacing: -.03em; line-height: 1.02; }
    .news-x__card-description { font-size: 1.3cqw; line-height: 1.16; margin-top: .6cqh; }
  }
</style>

