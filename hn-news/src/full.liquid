<div class="layout">
  <div class="hn">
    {% for group in (0..1) %}
      {% assign offset = group | times: 8 %}
      <div class="hn__col hn__og">
        {% for item in items offset: offset limit: 8 %}
          <div class="item">
            <div class="meta"><span class="index">{{ forloop.index | plus: offset }}</span></div>
            <div class="content">
              <span class="title title--small">{{ item.title }}</span>
              <div class="flex gap--small">
                <span class="label label--small label--underline">{{ item.score }} votes</span>
                {% if item.by != blank %}<span class="label label--small label--underline">by {{ item.by }}</span>{% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
    {% for group in (0..1) %}
      {% assign offset = group | times: 12 %}
      <div class="hn__col hn__x">
        {% for item in items offset: offset limit: 12 %}
          <div class="item">
            <div class="meta"><span class="index">{{ forloop.index | plus: offset }}</span></div>
            <div class="content">
              <span class="title title--small">{{ item.title }}</span>
              <div class="flex gap--small">
                <span class="label label--small label--underline">{{ item.score }} votes</span>
                {% if item.by != blank %}<span class="label label--small label--underline">by {{ item.by }}</span>{% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
    <div class="hn__read">
      {{ qr }}
      <span class="label label--small">Läs mer</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/hacker-news.svg">
  <span class="title">Hacker News</span>
  <span class="instance">Top Stories{% if capturedLabel != blank %} · {{ capturedLabel }}{% endif %}</span>
</div>
