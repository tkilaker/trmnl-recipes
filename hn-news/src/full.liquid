{% comment %}
Hacker News - Full Layout
Numbers match mini.tail899cb0.ts.net/las/hn, which the QR code opens.
{% endcomment %}

<style>
  .layout.hn { --serif: Georgia, "Times New Roman", serif; --sans: Arial, Helvetica, sans-serif; align-items: stretch; display: flex; flex-direction: column; }
  .hn__masthead { align-items: center; border-bottom: 3px double #000; display: flex; gap: 1.4cqw; padding-bottom: .9cqh; }
  .hn__mark { background: #000; color: #fff; font-family: var(--sans); font-size: 2.6cqw; font-weight: 700; line-height: 1; padding: .3cqh .8cqw; }
  .hn__brand { flex: 1; font-family: var(--serif); font-size: 3.6cqw; font-weight: 700; letter-spacing: -.035em; }
  .hn__time { font-family: var(--sans); font-size: 1.9cqw; font-weight: 700; margin-right: 1cqw; }
  .hn__body { display: grid; flex: 1; gap: 2cqw; grid-template-columns: minmax(0, 1fr) auto; min-height: 0; }
  .hn__list { display: grid; grid-template-rows: repeat(8, minmax(0, 1fr)); min-height: 0; }
  .hn__item { align-items: center; border-bottom: 1px solid #000; display: grid; gap: 1.4cqw; grid-template-columns: 3.2cqw minmax(0, 1fr); min-width: 0; }
  .hn__item:nth-child(8) { border-bottom: 0; }
  .hn__item:nth-child(n + 9) { display: none; }
  .hn__number { font-family: var(--serif); font-size: 2.5cqw; font-weight: 700; text-align: right; }
  .hn__title { -webkit-box-orient: vertical; -webkit-line-clamp: 1; display: -webkit-box; font-family: var(--serif); font-size: 2.2cqw; font-weight: 700; letter-spacing: -.015em; line-height: 1.1; overflow: hidden; }
  .hn__meta { font-family: var(--sans); font-size: 1.45cqw; margin-top: .3cqh; white-space: nowrap; }
  .hn__meta b { font-weight: 700; }
  .hn__rail { align-items: center; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 1cqh; }
  .hn__rail svg { display: block; height: 87px; width: 87px; }
  .hn__rail span { font-family: var(--sans); font-size: 1.3cqw; font-weight: 700; letter-spacing: .06em; margin-top: .8cqh; text-align: center; text-transform: uppercase; }
  .hn-empty { align-items: center; display: flex; font-size: 3cqw; font-weight: 700; }

  @media (min-width: 900px) {
    .hn__mark { font-size: 2.4cqw; }
    .hn__brand { font-size: 3.4cqw; }
    .hn__list { column-gap: 3cqw; grid-auto-flow: column; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(6, minmax(0, 1fr)); }
    .hn__item:nth-child(n + 9) { display: grid; }
    .hn__item:nth-child(8) { border-bottom: 1px solid #000; }
    .hn__item:nth-child(6), .hn__item:nth-child(12) { border-bottom: 0; }
    .hn__number { font-size: 2.6cqw; }
    .hn__title { -webkit-line-clamp: 3; font-size: 2.15cqw; line-height: 1.08; }
    .hn__meta { font-size: 1.4cqw; margin-top: .6cqh; }
    .hn__rail svg { height: 116px; width: 116px; }
    .hn__rail span { font-size: 1cqw; }
  }
</style>

<div class="layout hn" lang="sv">
  <header class="hn__masthead">
    <span class="hn__mark">Y</span>
    <span class="hn__brand">Hacker News</span>
    <span class="hn__time">{{ capturedLabel }}</span>
  </header>
  {% if items.size > 0 %}
    <section class="hn__body">
      <ol class="hn__list">
        {% for item in items limit: 12 %}
          <li class="hn__item">
            <span class="hn__number">{{ forloop.index }}</span>
            <div>
              <span class="hn__title">{{ item.title }}</span>
              <div class="hn__meta"><b>{{ item.domain }}</b> · {{ item.score }} p · {{ item.comments }} komm.</div>
            </div>
          </li>
        {% endfor %}
      </ol>
      <aside class="hn__rail">
